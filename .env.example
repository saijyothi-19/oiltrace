# ==============================================================================
# OILTRACE — Environment Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure the values for your local environment.
# NEVER commit your actual .env file or real secrets to version control.

# --- Core System Configuration ---
PROJECT_NAME=OILTRACE
APP_ENV=development
LOG_LEVEL=INFO

# Security / JWT Secret Key (REQUIRED: Set a secure, random string in your local .env)
# Generate via: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Configuration ---
# Local SQLite development (default):
# DATABASE_URL=sqlite:///./oiltrace.db
# Production PostgreSQL + PostGIS:
# DATABASE_URL=postgresql+psycopg2://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
DATABASE_URL=

# --- CORS Allowed Origins (JSON array of allowed URLs) ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://localhost:8000"]

# --- ML Model Configuration ---
MODEL_CHECKPOINT_DIR=./ml/models/unet/checkpoints
BASELINE_MODEL_PATH=./ml/models/unet/checkpoints/unet_oilspill_baseline.pt
INFERENCE_THRESHOLD=0.5
MIN_SPILL_AREA_KM2=0.01

# --- Drift Simulation Parameters ---
DRIFT_DEFAULT_PARTICLES=150
DRIFT_DEFAULT_DURATION_HOURS=12
DRIFT_TIMESTEP_MINUTES=15
WINDAGE_FACTOR=0.03
WIND_DEFLECTION_ANGLE_DEG=10.0

# --- AIS Correlation Parameters ---
SPATIAL_RADIUS_KM=50.0
TEMPORAL_WINDOW_HOURS=12.0

# --- Storage Directories ---
DATA_DIR=./data
SATELLITE_DIR=./data/satellite
AIS_DIR=./data/ais
ENVIRONMENTAL_DIR=./data/environmental
DEMO_DIR=./data/demo
REPORTS_DIR=./reports

# --- Frontend Configuration (Vite) ---
# Map Provider options: 'osm' (OpenStreetMap - default, free, zero key needed) or 'ocean' (Esri Ocean)
VITE_MAP_PROVIDER=osm
VITE_CARTO_API_KEY=
VITE_API_URL=http://localhost:8000
