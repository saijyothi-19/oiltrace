# ==============================================================================
# OILTRACE Frontend — Environment Configuration
# ==============================================================================

# GIS Basemap Provider Configuration
# Supported options:
#   - 'osm': OpenStreetMap standard (Default: 100% free, zero API key required)
#   - 'ocean': Esri World Ocean marine bathymetry (100% free, zero API key required)
#   - 'carto': CARTO Dark Matter (Requires valid VITE_CARTO_API_KEY; falls back to OSM if omitted)
VITE_MAP_PROVIDER=osm
VITE_CARTO_API_KEY=

# Backend API Service URL
VITE_API_URL=http://localhost:8000
